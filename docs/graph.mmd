%% 这张图由代码生成，别手改。重新生成：
%%   python -m app.harness > docs/graph.mmd
%% 图来自合成器（builtin/loop 骨架 + 当前挂载的片段），空锚点也会画出来。
%% 渲染 graph.png **不要**用 langchain 的 draw_mermaid_png：它用标准 base64 拼 URL，
%% payload 里一旦出现 '/' 就 404（实测）。走 urlsafe：
%%   b64 = base64.urlsafe_b64encode(Path("docs/graph.mmd").read_bytes()).decode()
%%   requests.get(f"https://mermaid.ink/img/{b64}?type=png&bgColor=!white").content
graph TD;
	__start__([<p>__start__</p>]):::first
	stamp(stamp)
	entry(entry)
	compact(compact)
	pre_model(pre_model)
	agent(agent)
	post_model(post_model)
	tools(tools)
	post_tools(post_tools)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> stamp;
	agent --> post_model;
	compact --> pre_model;
	entry --> compact;
	post_model -. &nbsp;__end__&nbsp; .-> finish;
	post_model -.-> tools;
	post_tools --> compact;
	pre_model --> agent;
	stamp --> entry;
	tools --> post_tools;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
