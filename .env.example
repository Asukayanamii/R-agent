# 复制为 .env 后填入真实值，.env 已被 .gitignore 忽略

# 默认走 DeepSeek，链路上使用 OpenAI 兼容协议。
# 换成百炼 / OpenAI / Ollama 时只改这三项，代码无需改动。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 会话状态落盘位置。相对路径按**项目根**解析，不受启动目录影响；
# 留空则仅存于进程内存（重启即失）。
SQLITE_PATH=./data/checkpoints.db

# 显式启用桩实现（复读消息 + 演练工具卡片 / 人工确认），用来在没有模型时调前端交互。
# 它**不是**兜底：没配 LLM_API_KEY 时对话接口会直接返回 error 说明情况。
AGENT_STUB=0

# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO。
# DEBUG 能看到每次写库、路径检查放行这类细节，排查问题时用。
LOG_LEVEL=INFO
