# 复制为 .env 后填入真实值，.env 已被 .gitignore 忽略

# 默认走 DeepSeek，链路上使用 OpenAI 兼容协议。
# 换成百炼 / OpenAI / Ollama 时只改这三项，代码无需改动。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 会话状态落盘位置。相对路径按**项目根**解析，不受启动目录影响；
# 留空则仅存于进程内存（重启即失）。
SQLITE_PATH=./data/checkpoints.db

# 显式启用桩实现（复读消息 + 演练工具卡片 / 人工确认），用来在没有模型时调前端交互。
# 它**不是**兜底：没配 LLM_API_KEY 时对话接口会直接返回 error 说明情况。
AGENT_STUB=0

# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO。
# DEBUG 能看到每次写库、路径检查放行这类细节，排查问题时用。
LOG_LEVEL=INFO

# ---- 上下文自动压缩 ----
# 模型的上下文窗口（tokens）。压缩阈值按它算，所以**按你实际用的模型填**：
# deepseek-chat 是 64000，gpt-4o 是 128000，Claude 系通常 200000。
# 填小了会偏早压缩（多花一次摘要调用），填大了要等 provider 报超窗才收敛。
# 不填按 64000 算——启动日志会打出实际用的值与来源，对着看就知道有没有生效。
LLM_CONTEXT_WINDOW=64000

# 1 开、0 关。关掉就完全回到"不压缩"的老行为。
COMPACT_ENABLED=1

# 触发线：估算的提示词 tokens ≥ 窗口 × 这个比例时压缩，取值 (0, 1]，默认 0.8。
COMPACT_AT=0.8

# 压缩时保留的最近原文预算（tokens），更早的中段摘要掉。默认 20000。
COMPACT_KEEP_TOKENS=20000

# 摘要用哪个模型，留空跟随 LLM_MODEL；填个小模型更快更便宜。
COMPACT_MODEL=
